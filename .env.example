APP_NAME=TickeTess
APP_ENV=development

APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./data/devcontrol.db

TIMEZONE=America/Fortaleza

# GITHUB_TOKEN é usado como padrão/fallback para projetos que não tiverem
# um token específico configurado na própria interface (tela do projeto).
GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_SYNC_INTERVAL=15

REPORT_ENABLED=true
REPORT_DAY=5
REPORT_TIME=17:30

BACKUP_ENABLED=true
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30

UPLOAD_MAX_SIZE_MB=20

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

SESSION_EXPIRE_DAYS=7
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
